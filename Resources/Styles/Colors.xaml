<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

    <!--  Brand  -->
    <Color x:Key="Ink">#1F2D4A</Color>
    <Color x:Key="InkLight">#C9D6EE</Color>
    <Color x:Key="Paper">#F2F3F1</Color>
    <Color x:Key="Shu">#C8432B</Color>
    <Color x:Key="ShuDark">#E0634B</Color>
    <Color x:Key="Kincha">#C99A2E</Color>
    <Color x:Key="KinchaDark">#D9AE4A</Color>
    <Color x:Key="Success">#3E7A55</Color>

    <!--  Surfaces and text (light / dark pairs)  -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1A2130</Color>
    <Color x:Key="BackgroundDark">#10151F</Color>
    <Color x:Key="TextPrimary">#1C2233</Color>
    <Color x:Key="TextPrimaryDark">#E8E9EC</Color>
    <Color x:Key="TextSecondary">#5F6675</Color>
    <Color x:Key="TextSecondaryDark">#A3A9B6</Color>
    <Color x:Key="Line">#E1E3E7</Color>
    <Color x:Key="LineDark">#2A3243</Color>

    <!--  Book spine palette  -->
    <Color x:Key="Spine1">#2F4D6E</Color>
    <Color x:Key="Spine2">#5C7F5A</Color>
    <Color x:Key="Spine3">#8E3B3F</Color>
    <Color x:Key="Spine4">#B98A2F</Color>
    <Color x:Key="Spine5">#4F5560</Color>

    <!--  Semantic aliases used by the control styles  -->
    <Color x:Key="Primary">#1F2D4A</Color>
    <Color x:Key="PrimaryDark">#C9D6EE</Color>
    <Color x:Key="PrimaryDarkText">#10151F</Color>
    <Color x:Key="Secondary">#E7EAF0</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E3E5E9</Color>
    <Color x:Key="Gray200">#C9CDD4</Color>
    <Color x:Key="Gray300">#ADB2BC</Color>
    <Color x:Key="Gray400">#9198A4</Color>
    <Color x:Key="Gray500">#6E7582</Color>
    <Color x:Key="Gray600">#424855</Color>
    <Color x:Key="Gray900">#1F232B</Color>
    <Color x:Key="Gray950">#14171D</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
