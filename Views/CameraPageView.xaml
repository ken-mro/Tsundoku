<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tsundoku.Views.CameraPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:Tsundoku.Resources"
    xmlns:viewmodels="clr-namespace:Tsundoku.ViewModels"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="{x:Static strings:AppResources.ISBNReader}"
    x:DataType="viewmodels:CameraPageViewModel">
    <Grid RowDefinitions="*,Auto" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <zxing:CameraBarcodeReaderView x:Name="cameraBarcodeReaderView" Grid.Row="0" BarcodesDetected="CameraBarcodeReaderView_BarcodesDetected" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
    </Grid>
</ContentPage>

