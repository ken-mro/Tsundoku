<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tsundoku.Views.CertificatePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Tsundoku.Models;assembly=Tsundoku"
    xmlns:strings="clr-namespace:Tsundoku.Resources"
    xmlns:viewmodels="clr-namespace:Tsundoku.ViewModels"
    Title="{x:Static strings:AppResources.Certificates}"
    x:DataType="viewmodels:CertificatePageViewModel">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VerticalStackLayout Padding="20,12,20,4" Spacing="2">
            <HorizontalStackLayout Spacing="4">
                <Label Style="{StaticResource DisplayNumber}" Text="{Binding ReadBookCertificatesCount}" />
                <Label
                    Margin="0,0,0,6"
                    Text="{x:Static strings:AppResources.Certificate_s_}"
                    VerticalOptions="End" />
            </HorizontalStackLayout>
            <Label Style="{StaticResource Caption}" Text="{Binding ReadThisYearString}" />
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                x:Name="collectionView"
                Margin="12,0"
                ItemsSource="{Binding ReadBookCertificates}"
                VerticalOptions="Fill">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="8"
                        Orientation="Vertical"
                        Span="{Binding GridItemSpan}"
                        VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:Book}">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItem
                                    BackgroundColor="{StaticResource Shu}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CertificatePageViewModel}}, x:DataType=viewmodels:CertificatePageViewModel, Path=DeleteCertificateCommand}"
                                    CommandParameter="{Binding .}"
                                    IconImageSource="swipe_delete.png" />
                            </SwipeView.LeftItems>
                            <Border Padding="5" Style="{StaticResource Card}">
                                <!--  Double gold rule, like the border of a printed certificate  -->
                                <Border
                                    Padding="3"
                                    Stroke="{AppThemeBinding Light={StaticResource Kincha},
                                                             Dark={StaticResource KinchaDark}}"
                                    StrokeShape="Rectangle"
                                    StrokeThickness="1.5">
                                    <Border
                                        Padding="14,12"
                                        Stroke="{AppThemeBinding Light={StaticResource Kincha},
                                                                 Dark={StaticResource KinchaDark}}"
                                        StrokeShape="Rectangle"
                                        StrokeThickness="0.5">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <Label Style="{StaticResource CertificateTitle}" Text="{x:Static strings:AppResources.ReadingCertificate}" />

                                            <!--  Ornamental divider: hairline, diamond, hairline  -->
                                            <Grid
                                                Grid.Row="1"
                                                Margin="24,0"
                                                ColumnDefinitions="*,Auto,*"
                                                ColumnSpacing="6">
                                                <BoxView
                                                    HeightRequest="0.5"
                                                    VerticalOptions="Center"
                                                    Color="{AppThemeBinding Light={StaticResource Kincha},
                                                                            Dark={StaticResource KinchaDark}}" />
                                                <BoxView
                                                    Grid.Column="1"
                                                    HeightRequest="5"
                                                    Rotation="45"
                                                    VerticalOptions="Center"
                                                    WidthRequest="5"
                                                    Color="{AppThemeBinding Light={StaticResource Kincha},
                                                                            Dark={StaticResource KinchaDark}}" />
                                                <BoxView
                                                    Grid.Column="2"
                                                    HeightRequest="0.5"
                                                    VerticalOptions="Center"
                                                    Color="{AppThemeBinding Light={StaticResource Kincha},
                                                                            Dark={StaticResource KinchaDark}}" />
                                            </Grid>

                                            <Grid
                                                Grid.Row="2"
                                                ColumnDefinitions="52,*,Auto"
                                                ColumnSpacing="12">
                                                <Border
                                                    Padding="0"
                                                    HeightRequest="74"
                                                    Stroke="{AppThemeBinding Light={StaticResource Line},
                                                                             Dark={StaticResource LineDark}}"
                                                    StrokeShape="Rectangle"
                                                    StrokeThickness="0.5"
                                                    VerticalOptions="Center"
                                                    WidthRequest="52">
                                                    <Image Aspect="AspectFill">
                                                        <Image.Source>
                                                            <UriImageSource
                                                                CacheValidity="30"
                                                                CachingEnabled="True"
                                                                Uri="{Binding SmallImageUrl}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Border>

                                                <Grid
                                                    Grid.Column="1"
                                                    ColumnSpacing="10"
                                                    RowDefinitions="Auto,Auto,Auto"
                                                    RowSpacing="4"
                                                    VerticalOptions="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label Style="{StaticResource Caption}" Text="ISBN" />
                                                    <Label
                                                        Grid.Column="1"
                                                        LineBreakMode="NoWrap"
                                                        Style="{StaticResource Data}"
                                                        Text="{Binding Isbn10}"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Style="{StaticResource Caption}"
                                                        Text="{x:Static strings:AppResources.ReadDate}" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        LineBreakMode="NoWrap"
                                                        Style="{StaticResource Data}"
                                                        Text="{Binding ReadDateString}"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                                    <Label
                                                        Grid.Row="2"
                                                        Style="{StaticResource Caption}"
                                                        Text="{x:Static strings:AppResources.TimeInStack}" />
                                                    <Label
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        LineBreakMode="NoWrap"
                                                        Style="{StaticResource Data}"
                                                        Text="{Binding DaysToFinishString}"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                                </Grid>

                                                <!--  Vermilion seal (rakkan), bottom right like a signed document  -->
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Shu},
                                                                                      Dark={StaticResource ShuDark}}"
                                                    HeightRequest="40"
                                                    StrokeShape="RoundRectangle 3"
                                                    StrokeThickness="0"
                                                    VerticalOptions="End"
                                                    WidthRequest="40">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontFamily="{OnPlatform iOS=HiraMinProN-W6,
                                                                                MacCatalyst=HiraMinProN-W6,
                                                                                Android=serif,
                                                                                Default=Georgia}"
                                                        FontSize="12"
                                                        HorizontalOptions="Center"
                                                        MaxLines="1"
                                                        Text="{x:Static strings:AppResources.Read}"
                                                        TextColor="{AppThemeBinding Light={StaticResource Surface},
                                                                                    Dark={StaticResource SurfaceDark}}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
