<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Tsundoku.Views.ConfirmBookView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:Tsundoku.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:Tsundoku.ViewModels"
    x:DataType="viewmodels:ConfirmBookViewModel"
    HeightRequest="450"
    WidthRequest="330">
    <Grid Padding="8" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image
            Aspect="AspectFit"
            HeightRequest="350"
            HorizontalOptions="Center"
            Source="{Binding ImageUrl}"
            VerticalOptions="Center" />
        <BoxView
            Grid.Row="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource Line},
                                              Dark={StaticResource LineDark}}"
            HeightRequest="1"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            Color="{AppThemeBinding Light={StaticResource Line},
                                    Dark={StaticResource LineDark}}" />
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Command="{Binding ReadBookCommand}"
                Style="{StaticResource SecondaryButton}"
                Text="{x:Static strings:AppResources.Read}" />
            <Button
                Grid.Column="1"
                Command="{Binding StackBookCommand}"
                Text="{x:Static strings:AppResources.Stack}" />
        </Grid>
    </Grid>
</toolkit:Popup>
