<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Tsundoku.Views.ConfirmBookView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:Tsundoku.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:Tsundoku.ViewModels"
    x:DataType="viewmodels:ConfirmBookViewModel"
    Size="330,450">
    <Grid
        Margin="5"
        Padding="10"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image
            Aspect="AspectFit"
            HeightRequest="350"
            HorizontalOptions="Center"
            Source="{Binding ImageUrl}"
            VerticalOptions="Center" />
        <BoxView
            Grid.Row="1"
            Margin="5,0"
            HeightRequest="1"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            Color="Gray" />
        <HorizontalStackLayout
            Grid.Row="2"
            HorizontalOptions="Center"
            Spacing="10">
            <Button
                Command="{Binding ReadBookCommand}"
                Text="{x:Static strings:AppResources.Read}" />
            <Button
                Command="{Binding StackBookCommand}"
                Text="{x:Static strings:AppResources.Stack}" />
        </HorizontalStackLayout>
    </Grid>
</toolkit:Popup>
